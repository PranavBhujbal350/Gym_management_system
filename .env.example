# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example Local: mongodb://localhost:27017/gym_management
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/gym_management?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/gym_management

# Flask Session Security Key
SECRET_KEY=gym-super-secret-key-change-this-in-production-12345

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
